# Copy to .env and fill in without quotes, .env is gitignored so never commit it

# Any long random string, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# TMDB API read access token (not the shorter API key)
TMDB_KEY=

# Neon connection string, leave blank to use the local SQLite app.db
DATABASE_URL=
